{
  "name": "sustain-ai",
  "version": "2.0.0",
  "type": "module",
  "description": "Provider-agnostic TypeScript SDK for transparent, scope-separated estimates of AI inference energy, water, and carbon.",
  "keywords": [
    "ai",
    "llm",
    "sustainability",
    "water",
    "energy",
    "carbon",
    "green-ai",
    "esg",
    "openai",
    "anthropic",
    "gemini",
    "mistral",
    "cohere",
    "ollama",
    "sustain",
    "metrics",
    "observability"
  ],
  "author": "SustAIn contributors",
  "license": "MIT",
  "homepage": "https://github.com/adl5423/SustAIn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adl5423/SustAIn.git"
  },
  "bugs": {
    "url": "https://github.com/adl5423/SustAIn/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}'); require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}');\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx demo.ts",
    "test:openai": "tsx test-openai.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.120.0 <1",
    "@google/genai": ">=2.18.0 <3",
    "@mistralai/mistralai": ">=2.6.3 <3",
    "cohere-ai": ">=8.0.1 <9",
    "openai": ">=7.5.0 <8"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@mistralai/mistralai": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@google/genai": "^2.18.0",
    "@mistralai/mistralai": "2.7.0",
    "@types/node": "catalog:",
    "cohere-ai": "^8.0.1",
    "openai": "^7.5.0",
    "tsx": "catalog:",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
