{
  "name": "sustain-ai",
  "version": "1.0.0",
  "description": "Provider-agnostic TypeScript SDK that wraps any LLM call (OpenAI, Anthropic, Gemini, Mistral, Cohere, Ollama, custom HTTP) and returns energy + water + carbon usage metrics with a human-readable sustainability footnote.",
  "keywords": [
    "ai",
    "llm",
    "sustainability",
    "water",
    "energy",
    "carbon",
    "green-ai",
    "esg",
    "openai",
    "anthropic",
    "gemini",
    "mistral",
    "cohere",
    "ollama",
    "sustain",
    "metrics",
    "observability"
  ],
  "author": "SustAIn contributors",
  "license": "MIT",
  "homepage": "https://github.com/adl5423/sustain-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adl5423/sustain-ai.git"
  },
  "bugs": {
    "url": "https://github.com/adl5423/sustain-ai/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}'); require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}');\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx demo.ts",
    "test:openai": "tsx test-openai.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "@google/generative-ai": ">=0.1.0",
    "@mistralai/mistralai": ">=0.1.0",
    "cohere-ai": ">=7.0.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    },
    "@mistralai/mistralai": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@google/generative-ai": "^0.24.0",
    "@mistralai/mistralai": "^1.5.0",
    "@types/node": "catalog:",
    "cohere-ai": "^7.15.0",
    "openai": "^4.93.0",
    "tsx": "catalog:",
    "typescript": "~5.9.2",
    "vitest": "^3.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
