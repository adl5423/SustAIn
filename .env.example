TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Static mockup development and preview. Keep loopback defaults locally.
BASE_PATH=/
DEV_HOST=127.0.0.1
DEV_ALLOWED_HOSTS=localhost
