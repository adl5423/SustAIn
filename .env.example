# Server-side provider credentials. Leave unused values empty.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
