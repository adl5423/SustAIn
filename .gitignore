# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Build output
dist
build
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# Dependencies
node_modules

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
testem.log
/coverage

# Environment files
.env
.env.*
!.env.example

# Local credentials and private key material
*.key
*.pem
*.p12
*.pfx
*.jks
credentials.json
service-account*.json
.npmrc.local

# IDE and editor settings
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.cursor/
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Misc
/.sass-cache
/connect.lock
/libpeerconnection.log
/typings

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Workspace and platform metadata
.cache/
.local/
.agents/
.replit
.replitignore
replit.md
attached_assets/

# Local security-scan evidence may contain source excerpts and machine paths.
groundhog-reports/
.groundhog-cache/
.groundhog/*
!.groundhog/baseline.json
.pnpm-store/
